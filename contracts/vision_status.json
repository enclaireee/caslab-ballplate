{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "vision_status",
  "description": "Vision health. fps in frames/s, latency_ms in milliseconds, ball_found whether ball is currently detected.",
  "type": "object",
  "properties": {
    "fps": {
      "type": "number",
      "minimum": 0,
      "description": "Frames per second."
    },
    "latency_ms": {
      "type": "number",
      "minimum": 0,
      "description": "Capture-to-position latency, milliseconds."
    },
    "ball_found": {
      "type": "boolean",
      "description": "Ball currently detected."
    }
  },
  "required": [
    "fps",
    "latency_ms",
    "ball_found"
  ],
  "additionalProperties": false
}
