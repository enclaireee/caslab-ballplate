{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "pid_gains",
  "description": "PID gains; output is plate tilt in degrees, error in mm (x right, y up). kp deg/mm, ki deg/(mm.s), kd deg.s/mm.",
  "type": "object",
  "properties": {
    "axis": {
      "type": "string",
      "enum": [
        "x",
        "y",
        "both"
      ],
      "description": "Axis the gains apply to."
    },
    "kp": {
      "type": "number",
      "minimum": 0,
      "description": "deg/mm"
    },
    "ki": {
      "type": "number",
      "minimum": 0,
      "description": "deg/(mm.s)"
    },
    "kd": {
      "type": "number",
      "minimum": 0,
      "description": "deg.s/mm"
    }
  },
  "required": [
    "axis",
    "kp",
    "ki",
    "kd"
  ],
  "additionalProperties": false
}
